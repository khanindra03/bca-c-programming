#include <stdio.h>

struct Student {
    int roll;
    char name[30];
    float marks;
};

int main() {
    struct Student s[5];
    int i, highest = 0;

    for(i = 0; i < 5; i++) {
        printf("Enter Roll, Name and Marks for Student %d: ", i + 1);
        scanf("%d %s %f", &s[i].roll, s[i].name, &s[i].marks);
    }

    for(i = 1; i < 5; i++) {
        if(s[i].marks > s[highest].marks) {
            highest = i;
        }
    }

    printf("\n--- Topper Details ---\n");
    printf("Roll: %d\n", s[highest].roll);
    printf("Name: %s\n", s[highest].name);
    printf("Marks: %.2f\n", s[highest].marks);

    return 0;
}
